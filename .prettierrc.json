{
	"$schema": "https://json.schemastore.org/prettierrc",
	"plugins": ["prettier-plugin-organize-imports"],
	"semi": true,
	"tabWidth": 4,
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 80,
	"trailingComma": "all",
	"overrides": [
		{
			"files": ["*.vue", "*.html"],
			"options": {
				"printWidth": 100
			}
		},
		{
			"files": ["*.yaml", "*.yml"],
			"options": {
				"tabWidth": 2,
				"useTabs": false
			}
		}
	]
}
