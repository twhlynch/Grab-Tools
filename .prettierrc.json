{
	"$schema": "https://json.schemastore.org/prettierrc",
	"plugins": ["prettier-plugin-organize-imports"],
	"semi": true,
	"tabWidth": 4,
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 80,
	"trailingComma": "all",
	"overrides": [
		{
			"files": "*.vue",
			"options": {
				"printWidth": 100
			}
		}
	]
}
